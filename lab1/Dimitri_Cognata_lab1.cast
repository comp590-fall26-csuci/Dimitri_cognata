[5005.869087, "o", "\u001bP+q436f\u001b\\\u001bP+q6b75\u001b\\\u001bP+q6b64\u001b\\\u001bP+q6b72\u001b\\\u001bP+q6b6c\u001b\\\u001bP+q2332\u001b\\\u001bP+q2334\u001b\\\u001bP+q2569\u001b\\\u001bP+q2a37\u001b\\\u001bP+q6b31\u001b\\\u001bP$q q\u001b\\\u001b[?12$p\u001b[?25l\u001b[57;116H0\u001b[1;1H\u001b[57;117H0\u001b[1;1H\u001b[57;118H0\u001b[1;1H\u001b[57;119H/\u001b[1;1H\u001b[57;120H0\u001b[1;1H\u001b[57;121H0\u001b[1;1H\u001b[57;122H0\u001b[1;1H\u001b[57;123H0\u001b[1;1H\u001b[57;124H/\u001b[1;1H\u001b[57;125H0\u001b[1;1H"]
[5005.871299, "o", "\u001b[57;116H          \u001b[1;1H\u001b[27m\u001b[23m\u001b[29m\u001b[m\u001b[H\u001b[2J\u001b[1;1H\u001b[96m# Dimitri Cognata\r\n\r\n# Course: COMP 590\r\n\r\n# Lab: Lab 1\r\n\r\n# Fib sequence logic taken from GeekforGeeks:\r\n\r\n# https://www.geeksforgeeks.org/python/python-program-to-print-the-fibonacci-sequence/\u001b[m\r\n\r\n\u001b[93mdef\u001b[m \u001b[1m\u001b[96mfibonacci\u001b[m(n):\r\n    \u001b[96m# start with the first two fib numbers\u001b[m\r\n    a, b = \u001b[95m0\u001b[m, \u001b[95m1\u001b[m\u001b[15;5H\u001b[96m#write the first numbers to the output file\u001b[m\r\n    \u001b[93mwith\u001b[m \u001b[1m\u001b[96mopen\u001b[m(\u001b[95m\"output/fibonacci.txt\"\u001b[m,\u001b[95m\"w\"\u001b[m) \u001b[93mas\u001b[m file:\u001b[17;9H\u001b[93mfor\u001b[m _ \u001b[93min\u001b[m \u001b[1m\u001b[96mrange\u001b[m(n):\u001b[18;13H\u001b[1m\u001b[96mprint\u001b[m(a, file=file)\u001b[19;13Ha, b = b, a + b\r\n\r\n\u001b[96m#generat the first 25 fib numbers\u001b[m\r\nfibonacci(\u001b[95m25\u001b[m)\r\n\u001b[94m~                                                                                                                                              \u001b[24;1H~                                                                                                                                              \u001b[25;1H~                                                                                                                                              \u001b[26;1H~                                                                                                                                              \u001b[27;1H~                                                                                                                                              \u001b[28;1H~                                                                                                                                              \u001b[29;1H~                                                                                                                                              \u001b[30;1H~                                                                                                                                              \u001b[31;1H~                                                                                                                                              \u001b[32;1H~                                                                                                                                              \u001b[33;1H~                                                                                                                                              \u001b[34;1H~                                                                                                                                              \u001b[35;1H~                                                                                                                                              \u001b[36;1H~                                                                                                                                              \u001b[37;1H~                                                                                                                                              \u001b[38;1H~                                                                                                                                              \u001b[39;1H~                                                                                                                                              \u001b[40;1H~                                                                                                                                              \u001b[41;1H~                                                                                                                                              \u001b[42;1