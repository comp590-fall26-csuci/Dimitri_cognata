[5562.126811, "o", "\u001b[?1h\u001b=\r\u001b[1mdiff --git a/lab1/lab1.py b/lab1/lab1.py\u001b[m\u001b[m\r\n\u001b[1mindex d7e5a69..7508c53 100644\u001b[m\u001b[m\r\n\u001b[1m--- a/lab1/lab1.py\u001b[m\u001b[m\r\n\u001b[1m+++ b/lab1/lab1.py\u001b[m\u001b[m\r\n\u001b[36m@@ -1,22 +1,25 @@\u001b[m\u001b[m\r\n # Dimitri Cognata\u001b[m\u001b[m\r\n \u001b[m\u001b[m\r\n\u001b[31m-# Course: COMP 590\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m# Course: Comp 590\u001b[m\u001b[m\r\n \u001b[m\u001b[m\r\n # Lab: Lab 1\u001b[m\u001b[m\r\n \u001b[m\u001b[m\r\n\u001b[31m-# Fib sequence logic taken from GeekforGeeks:\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m# Fib sequence taken from GeekforGeeks\u001b[m\u001b[m\r\n \u001b[m\u001b[m\r\n # https://www.geeksforgeeks.org/python/python-program-to-print-the-fibonacci-sequence/\u001b[m\u001b[m\r\n \u001b[m\u001b[m\r\n def fibonacci(n):\u001b[m\u001b[m\r\n\u001b[31m-    # start with the first two fib numbers\u001b[m\u001b[m\r\n\u001b[31m-    a, b = 0, 1\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    # Return the base Fib numbers\u001b[m\u001b[m\r\n \u001b[m\u001b[m\r\n\u001b[31m-    #write the first numbers to the output file\u001b[m\u001b[m\r\n\u001b[31m-    with open(\"output/fibonacci.txt\",\"w\") as file:\u001b[m\u001b[m\r\n\u001b[31m-        for _ in range(n):\u001b[m\u001b[m\r\n\u001b[31m-            print(a, file=file)\u001b[m\u001b[m\r\n\u001b[31m-            a, b = b, a + b\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    if n <= 1:\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        return n\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    #Calculate the number using the previous two numbers\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    return fibonacci(n -1) + fibonacci(n -2)\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m# Write the first 25 fib numbers to an ouput file\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mwith open(\"output/fibonacci.txt\", \"w\") as file:\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    for number in range(25):\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        print(fibonacci(number), file=file)\u001b[m\u001b[m\r\n \u001b[m\u001b[m\r\n\u001b[31m-#generat the first 25 fib numbers\u001b[m\u001b[m\r\n\u001b[31m-fibonacci(25)\u001b[m\u001b[m\r\n\r\u001b[K\u001b[?1l\u001b>"]
