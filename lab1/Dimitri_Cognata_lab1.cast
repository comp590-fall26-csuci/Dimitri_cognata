[5005.850092, "o", "\u001b[2;1H▽\u001b[6n\u001b[2;1H  \u001b[3;1H\u001bPzz\u001b\\\u001b[0%m\u001b[6n\u001b[3;1H           \u001b[1;1H\u001b[>c\u001b]10;?\u0007\u001b]11;?\u0007"]
[5005.852009, "o", "\u001b[1;1H\u001b[34m# Dimitri Cognata\u001b[m\u001b[2;1H\u001b[K\u001b[3;1H\u001b[34m# Course: COMP 590\u001b[m\u001b[3;19H\u001b[K\u001b[5;1H\u001b[34m# Lab: Lab 1\r\n\r\n# Fib sequence logic taken from GeekforGeeks:\r\n\r\n# https://www.geeksforgeeks.org/python/python-program-to-print-the-fibonacci-sequence/\u001b[m\r\n\r\n\u001b[38;5;130mdef\u001b[m \u001b[36mfibonacci\u001b[m(n):\r\n    \u001b[34m# start with the first two fib numbers\u001b[m\r\n    a, b = \u001b[31m0\u001b[m, \u001b[31m1\u001b[m\u001b[15;5H\u001b[34m#write the first numbers to the output file\u001b[m\r\n    \u001b[38;5;130mwith\u001b[m \u001b[36mopen\u001b[m(\u001b[31m\"output/fibonacci.txt\"\u001b[m,\u001b[31m\"w\"\u001b[m) \u001b[38;5;130mas\u001b[m file:\u001b[17;9H\u001b[38;5;130mfor\u001b[m _ \u001b[38;5;130min\u001b[m \u001b[36mrange\u001b[m(n):\u001b[18;13H\u001b[36mprint\u001b[m(a, file=file)\u001b[19;13Ha, b = b, a + b\r\n\r\n\u001b[34m#generat the first 25 fib numbers\u001b[m\r\nfibonacci(\u001b[31m25\u001b[m)\r\n\u001b[94m~                                                                                                                                              \u001b[24;1H~                                                                                                                                              \u001b[25;1H~                                                                                                                                              \u001b[26;1H~                                                                                                                                              \u001b[27;1H~                                                                                                                                              \u001b[28;1H~                                                                                                                                              \u001b[29;1H~                                                                                                                                              \u001b[30;1H~                                                                                                                                              \u001b[31;1H~                                                                                                                                              \u001b[32;1H~                                                                                                                                              \u001b[33;1H~                                                                                                                                              \u001b[34;1H~                                                                                                                                              \u001b[35;1H~                                                                                                                                              \u001b[36;1H~                                                                                                                                              \u001b[37;1H~                                                                                                                                              \u001b[38;1H~                                                                                                                                              \u001b[39;1H~                                                                                                                                              \u001b[40;1H~                                                                                                                                              \u001b[41;1H~                                                                                                                                              \u001b[42;1H~                                                                                                                                              \u001b[43;1H~                                                                                                                                              \u001b[44;1H~                                                                                                                                              \u001b[45;1H~                                                               "]
