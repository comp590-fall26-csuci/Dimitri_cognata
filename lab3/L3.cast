[2382.861494, "o", "\u001b[2;1H\u001b[96m# Dimitri Cognata\u001b[m\u001b[2;18H\u001b[K\u001b[3;1H\u001b[K\u001b[4;1H\u001b[96m# Course: COMP 590\u001b[m\u001b[4;19H\u001b[K\u001b[5;1H\u001b[K\u001b[6;1H\u001b[96m# Lab: Lab 1\u001b[m\u001b[6;13H\u001b[K\u001b[7;1H\u001b[K\u001b[8;1H\u001b[96m# Fib sequence logic taken from GeekforGeeks:\u001b[m\u001b[8;46H\u001b[K\u001b[9;1H\u001b[K\u001b[10;1H\u001b[96m# https://www.geeksforgeeks.org/python/python-program-to-print-the-fibonacci-sequence/\u001b[m\u001b[10;87H\u001b[K\u001b[11;1H\u001b[K\u001b[12;1Hdef fibonacci(n):\u001b[12;18H\u001b[K\u001b[13;1H    # start with the first two fib numbers\u001b[13;43H\u001b[K\u001b[14;1H    a, b = 0, 1\u001b[14;16H\u001b[K\u001b[15;1H\u001b[K\u001b[16;1H    #write the first numbers to the output file\u001b[16;48H\u001b[K\u001b[17;1H    with open(\"output\u001b[38;5;224m/\u001b[mfibonacci.txt\",\"w\") as file:\u001b[17;51H\u001b[K\u001b[18;1H        for _ in range(n):\u001b[18;27H\u001b[K\u001b[19;1H            print(a, file=file)\u001b[19;32H\u001b[K\u001b[20;1H            a, b = b, a + b\u001b[20;28H\u001b[K\u001b[21;1H\u001b[K\u001b[22;1H\u001b[96m#generat the first 25 fib numbers\u001b[m\u001b[22;34H\u001b[K\u001b[23;1Hfibonacci(25)\u001b[23;14H\u001b[K\u001b[42;165H2,1\u001b[11CAll\u001b[42;165H\u001b[K\u001b[42;165H2,1\u001b[11CAll\u001b[2;1H\u001b[?25h"]
