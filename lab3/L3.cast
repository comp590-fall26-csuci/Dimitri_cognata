[5142.913513, "o", "f"]
[5143.077056, "o", "i"]
[5143.540121, "o", "b"]
[5143.668996, "o", "onacci.c "]
[5144.278676, "o", "\r\n\u001b[?2004l\r"]
[5144.281153, "o", "#include <math.h>\r\n#include \"fibonacci.h\"\r\n\r\nint fibonacci(int n) {\r\n    if (n <= 0) return 0;\r\n    if (n == 1) return 1;\r\n    return fibonacci(n - 1) + fibonacci(n - 2);\r\n}\r\n\r\n/* Uses the square root function to calculate an analytical approximation */\r\ndouble golden_ratio_approx(int n) {\r\n    double phi = (1.0 + sqrt(5.0)) / 2.0;\r\n    return phi;\r\n}\r\n"]
