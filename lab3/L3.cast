[5140.153378, "o", "\r\n\u001b[?2004l\r"]
[5140.156118, "o", "#include <stdio.h>\r\n#include \"fibonacci.h\"\r\n\r\nint main(void) {\r\n    int term = 10;\r\n    printf(\"The %dth Fibonacci number is %d\\n\", term, fibonacci(term));\r\n    printf(\"The theoretical Golden Ratio is %f\\n\", golden_ratio_approx(term));\r\n    return 0;\r\n}\r\n"]
[5140.156689, "o", "\u001b[?2004h\u001b]0;dameech@Debian13: ~/comp590/Dimitri_cognata/lab3/590MakefileLab\u0007\u001b[01;32mdameech@Debian13\u001b[00m:\u001b[01;34m~/comp590/Dimitri_cognata/lab3/590MakefileLab\u001b[00m$ "]
